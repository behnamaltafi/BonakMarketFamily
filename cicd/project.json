{
  "schemaVersion": 1,
  "id": "bonakmarketfamily",
  "solution": "BonakMarket.sln",
  "github": {
    "repository": "behnamaltafi/BonakMarketFamily"
  },
  "build": {
    "configuration": "Release",
    "tests": true,
    "coverage": {
      "enabled": false,
      "minimum": 0.8
    }
  },
  "release": {
    "enabled": false,
    "developPrerelease": false
  },
  "artifacts": [
    {
      "type": "zip",
      "name": "web",
      "project": "src/BonakMarket.Web/BonakMarket.Web.csproj"
    },
    {
      "type": "docker",
      "name": "web",
      "project": "src/BonakMarket.Web/BonakMarket.Web.csproj",
      "assembly": "BonakMarket.Web.dll",
      "repository": "nexus.bonakfamily.ir/bonakmarketfamily/web",
      "runtimeImage": "mcr.microsoft.com/dotnet/aspnet:10.0"
    }
  ],
  "nexus": {
    "baseUrl": "https://nexus.bonakfamily.ir",
    "rawRepository": "bonakmarketfamily-releases",
    "rawRepositoryMode": "dedicated"
  },
  "credentials": {
    "platformReader": "cicd-platform-read",
    "nexusPublisher": "common-nexus-admin",
    "githubPublisher": "bonakmarketfamily-github-release"
  }
}
