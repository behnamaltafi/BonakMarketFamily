<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
        <!-- Solution builds reject a global RuntimeIdentifier; CI forwards its RID to application projects here. -->
        <RuntimeIdentifier Condition="'$(BonakMarketBuildRuntime)' != '' And '$(RuntimeIdentifier)' == ''">$(BonakMarketBuildRuntime)</RuntimeIdentifier>
        <!--<RuntimeIdentifiers>win-x64; osx-x64; linux-x64</RuntimeIdentifiers>-->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<SatelliteResourceLanguages>ar; de; de-DE; es; fa; fr; it; ja; nl; pt; pt-BR; ru; sv; tr; vi; zh-CN</SatelliteResourceLanguages>
		<CopyRefAssembliesToPublishDirectory>false</CopyRefAssembliesToPublishDirectory>
        <ChecksumAlgorithm>SHA1</ChecksumAlgorithm>
		<Configurations>Debug;Release;DebugNoRazorCompile</Configurations>
		<NoWarn>$(NoWarn);1573;1591;1701;1702;CS9216</NoWarn>
	</PropertyGroup>

    <PropertyGroup>
		<Product>BonakMarket</Product>
		<Copyright>Copyright © BonakMarket AG</Copyright>
		<Company>BonakMarket AG</Company>
		<Authors>BonakMarket AG</Authors>
		<Version>6.4.0.0</Version>
		<FileVersion>6.4.0.0</FileVersion>
		<InformationalVersion>6.4.0.0</InformationalVersion>
		<PackageProjectUrl>https://BonakMarket.com/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BonakMarket/BonakMarket</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugNoRazorCompile|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
	</PropertyGroup>

</Project>
