            <DistFiles Include="
            $(BinDir)BonakMarket.Data.SqlServer.dll;
            $(BinDir)BonakMarket.Data.MySql.dll;
            $(BinDir)BonakMarket.Data.PostgreSql.dll;
            $(BinDir)Microsoft.EntityFrameworkCore.SqlServer.dll;
            $(BinDir)Pomelo.EntityFrameworkCore.MySql.dll;
