<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <Copyright>Copyright © BonakMarket AG</Copyright>
    <Company>BonakMarket AG</Company>
    <Authors>BonakMarket AG</Authors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup> 

  <Target Name="BuildModule">   
    <!--  
    	Resolves private module references (packages) and copies them to the output directory.
    	Also deletes unnecessary files and folders from output.
    -->  
    <Exec Command="dotnet BonakMarket.ModuleBuilder.dll &quot;OutPath=$(OutPath)&quot; &quot;ProjectPath=$(ProjectPath)&quot;" />
  </Target>      
</Project>
