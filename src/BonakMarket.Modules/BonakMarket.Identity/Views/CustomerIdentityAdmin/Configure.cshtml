@model IdentityConfigurationModel
@{
    Layout = "_ConfigureModule";
}
<widget target-zone="admin_button_toolbar_before">
    <button id="SaveConfigButton" type="submit" name="save" class="btn btn-primary" value="save" form="customer-identity-settings">
        <icon name="check" />
        <span>@T("Admin.Common.Save")</span>
    </button>
</widget>
<form id="customer-identity-settings" asp-action="Configure" method="post" autocomplete="off">
    <div asp-validation-summary="All"></div>
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle">
                <smart-label asp-for="OtpLoginEnabled" />
            </div>
            <div class="adminData">
                <setting-editor asp-for="OtpLoginEnabled" />
                <span asp-validation-for="OtpLoginEnabled"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                <smart-label asp-for="SmsAsPrimaryLogin" />
            </div>
            <div class="adminData">
                <setting-editor asp-for="SmsAsPrimaryLogin" />
                <span asp-validation-for="SmsAsPrimaryLogin"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="LoginOtpTemplateKey" /></div>
            <div class="adminData">
                <select asp-for="LoginOtpTemplateKey" class="form-control">
                    @if (!Model.OtpTemplates.Any(t => string.Equals(t.Key, Model.LoginOtpTemplateKey, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@Model.LoginOtpTemplateKey">@Model.LoginOtpTemplateKey — @T("Plugins.Identity.Customer.Fields.OtpTemplateUnavailableShort")</option>
                    }
                    @foreach (var template in Model.OtpTemplates)
                    {
                        <option value="@template.Key">@template.Title (@template.Key) @(template.IsReady ? "" : "— " + T("Plugins.Identity.Customer.Fields.OtpTemplateUnavailableShort").Value)</option>
                    }
                </select>
                <span asp-validation-for="LoginOtpTemplateKey"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PhoneEnrollmentOtpTemplateKey" /></div>
            <div class="adminData">
                <select asp-for="PhoneEnrollmentOtpTemplateKey" class="form-control">
                    @if (!Model.OtpTemplates.Any(t => string.Equals(t.Key, Model.PhoneEnrollmentOtpTemplateKey, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@Model.PhoneEnrollmentOtpTemplateKey">@Model.PhoneEnrollmentOtpTemplateKey — @T("Plugins.Identity.Customer.Fields.OtpTemplateUnavailableShort")</option>
                    }
                    @foreach (var template in Model.OtpTemplates)
                    {
                        <option value="@template.Key">@template.Title (@template.Key) @(template.IsReady ? "" : "— " + T("Plugins.Identity.Customer.Fields.OtpTemplateUnavailableShort").Value)</option>
                    }
                </select>
                <span asp-validation-for="PhoneEnrollmentOtpTemplateKey"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ReauthenticationOtpTemplateKey" /></div>
            <div class="adminData">
                <select asp-for="ReauthenticationOtpTemplateKey" class="form-control">
                    @if (!Model.OtpTemplates.Any(t => string.Equals(t.Key, Model.ReauthenticationOtpTemplateKey, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@Model.ReauthenticationOtpTemplateKey">@Model.ReauthenticationOtpTemplateKey — @T("Plugins.Identity.Customer.Fields.OtpTemplateUnavailableShort")</option>
                    }
                    @foreach (var template in Model.OtpTemplates)
                    {
                        <option value="@template.Key">@template.Title (@template.Key) @(template.IsReady ? "" : "— " + T("Plugins.Identity.Customer.Fields.OtpTemplateUnavailableShort").Value)</option>
                    }
                </select>
                <span asp-validation-for="ReauthenticationOtpTemplateKey"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"></div>
            <div class="adminData">
                <p class="text-muted">@T("Plugins.Identity.Customer.Fields.OtpTemplateHelp")</p>
                @if (!Model.OtpTemplates.Any(t => t.IsReady))
                {
                    <div class="alert alert-warning">@T("Plugins.Identity.Customer.Fields.NoReadyOtpTemplates")</div>
                }
                <a asp-area="Admin" asp-controller="MultiSms" asp-action="Templates" class="btn btn-outline-secondary">@T("Plugins.Identity.Customer.Fields.ManageOtpTemplates")</a>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="OtpResendIntervalSeconds" /></div>
            <div class="adminData">
                <input asp-for="OtpResendIntervalSeconds" type="number" min="30" max="300" class="form-control" />
                <span asp-validation-for="OtpResendIntervalSeconds"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="OtpExpirationSeconds" /></div>
            <div class="adminData">
                <input asp-for="OtpExpirationSeconds" type="number" min="60" max="600" class="form-control" />
                <span asp-validation-for="OtpExpirationSeconds"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="OtpMaxDailyRequests" /></div>
            <div class="adminData">
                <input asp-for="OtpMaxDailyRequests" type="number" min="1" max="50" class="form-control" />
                <span asp-validation-for="OtpMaxDailyRequests"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="OtpMaxVerificationAttempts" /></div>
            <div class="adminData">
                <input asp-for="OtpMaxVerificationAttempts" type="number" min="1" max="5" class="form-control" />
                <span asp-validation-for="OtpMaxVerificationAttempts"></span>
            </div>
        </div>
    </div>
</form>
