@model string

@{
    // This widget is rendered INSIDE the native Customer/Info form.
    // Use buttons + same-origin fetch: nested forms would be invalid markup.
    var sessionUrl = Url.Content("~/api/identity/v1/auth/session");
    var requestUrl = Url.Content("~/api/identity/v1/me/security/phone/request");
    var verifyUrl = Url.Content("~/api/identity/v1/me/security/phone/verify");
    var reauthRequestUrl = Url.Content("~/api/identity/v1/me/security/phone/reauth/request");
    var reauthVerifyUrl = Url.Content("~/api/identity/v1/me/security/phone/reauth/verify");
}

<div id="multi-sms-phone-settings" class="card mb-4"
     data-session-url="@sessionUrl"
     data-request-url="@requestUrl"
     data-verify-url="@verifyUrl"
     data-reauth-request="@reauthRequestUrl" data-reauth-verify="@reauthVerifyUrl" data-bound="@(!string.IsNullOrEmpty(Model) ? "true" : "false")" data-login-url="@Url.Content("~/login")"
     data-requested="@T("Plugins.Identity.Customer.Otp.ChangePhoneRequested")"
     data-success="@T("Plugins.Identity.Customer.Otp.ChangePhoneSucceeded")"
     data-error="@T("Plugins.Identity.Customer.Otp.ChangePhoneFailed")"
     data-invalid="@T("Plugins.Identity.Customer.Otp.InvalidPhone")">
    <div class="card-body">
        <h4 class="h5">@T("Plugins.Identity.Customer.Otp.PhoneManageTitle")</h4>
        <p class="small text-muted">@T("Plugins.Identity.Customer.Otp.PhoneManageHint")</p>

        <div class="mb-3">
            <strong>@T("Plugins.Identity.Customer.Otp.VerifiedLoginPhone"):</strong>
            <span id="multi-sms-current-phone" dir="ltr">
                @(Model ?? T("Plugins.Identity.Customer.Otp.UnverifiedLoginPhone").Value)
            </span>
        </div>
        @if (!string.IsNullOrEmpty(Model))
        {
            <div class="mb-3">
                <button type="button" id="sms-reauth-request" class="btn btn-outline-primary">ارسال کد به موبایل فعلی</button>
                <input id="sms-reauth-code" class="form-control mt-2" inputmode="numeric" maxlength="6" placeholder="کد موبایل فعلی" />
                <button type="button" id="sms-reauth-verify" class="btn btn-outline-primary mt-2">تأیید موبایل فعلی</button>
            </div>
        }
        <div class="mb-3">
            <label for="multi-sms-new-phone" class="form-label">@T("Plugins.Identity.Customer.Otp.NewPhoneLabel")</label>
            <input id="multi-sms-new-phone" class="form-control" type="tel"
                   inputmode="tel" autocomplete="tel" maxlength="20" dir="ltr"
                   placeholder="09123456789" />
        </div>

        <button id="multi-sms-request-phone" type="button" class="btn btn-outline-primary">
            @T("Plugins.Identity.Customer.Otp.RequestPhoneChange")
        </button>

        <div id="multi-sms-verify-controls" class="mt-3" hidden>
            <label for="multi-sms-phone-code" class="form-label">@T("Plugins.Identity.Customer.Otp.CodeLabel")</label>
            <input id="multi-sms-phone-code" type="text" class="form-control" inputmode="numeric"
                   autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" dir="ltr" />
            <button id="multi-sms-verify-phone" type="button" class="btn btn-primary mt-2">
                @T("Plugins.Identity.Customer.Otp.VerifyPhoneChange")
            </button>
        </div>

        <p id="multi-sms-phone-status" role="status" class="mt-3 mb-0" aria-live="polite"></p>
    </div>
</div>

<script>
(function () {
    function initSmsPhoneEditor() {
        const root = document.getElementById("multi-sms-phone-settings");
        if (!root || root.dataset.initialized === "true") return;
        root.dataset.initialized = "true";

        const phoneInput = root.querySelector("#multi-sms-new-phone");
        const codeInput = root.querySelector("#multi-sms-phone-code");
        const currentPhone = root.querySelector("#multi-sms-current-phone");
        const status = root.querySelector("#multi-sms-phone-status");
        const requestButton = root.querySelector("#multi-sms-request-phone");
        const verifyButton = root.querySelector("#multi-sms-verify-phone");
        const verification = root.querySelector("#multi-sms-verify-controls");
        let pendingPhone = "";
        let reauthToken = null;
        if(root.dataset.bound === "true") requestButton.disabled = true;

        function normalized(value) {
            return (value || "").trim()
                .replace(/[۰-۹]/g, c => String(c.charCodeAt(0) - 1776))
                .replace(/[٠-٩]/g, c => String(c.charCodeAt(0) - 1632));
        }

        function localPhone(phone) {
            return typeof phone === "string" && phone.startsWith("+98")
                ? "0" + phone.slice(3) : phone;
        }

        // Native Customer.Info contains a separate free-text contact-number field.
        // When SMS login is active, do not let it appear to change the verified login
        // number without OTP. Preserve its value during normal profile submissions.
        const nativePhone = document.querySelector('form[method="post"] input[name="Phone"]');
        if (nativePhone && !root.contains(nativePhone)) {
            nativePhone.readOnly = true;
            nativePhone.title = root.dataset.invalid;
        }

        function setStatus(message, ok) {
            status.textContent = message;
            status.className = "mt-3 mb-0 " + (ok ? "text-success" : "text-danger");
        }

        async function otpRequest(path, payload) {
            const sessionResponse = await fetch(root.dataset.sessionUrl, {
                credentials: "same-origin", cache: "no-store"
            });
            if (!sessionResponse.ok) throw new Error("session_failed");
            const session = await sessionResponse.json();
            if (!session.enabled || !session.isAuthenticated || !session.requestToken ||
                !session.headerName) throw new Error("not_authenticated");

            const headers = { "Content-Type": "application/json" };
            headers[session.headerName] = session.requestToken;
            const result = await fetch(path, {
                method: "POST",
                credentials: "same-origin",
                cache: "no-store",
                headers,
                body: JSON.stringify(payload)
            });
            if (!result.ok) throw new Error("verification_failed");
            return result.json();
        }

        const oldRequest=root.querySelector("#sms-reauth-request"), oldVerify=root.querySelector("#sms-reauth-verify");
        if(oldRequest && oldVerify){
            oldRequest.onclick=async()=>{oldRequest.disabled=true;try{await otpRequest(root.dataset.reauthRequest,{});setStatus("کد به موبایل فعلی ارسال شد.",true);}catch(_){setStatus(root.dataset.error,false);}finally{oldRequest.disabled=false;}};
            oldVerify.onclick=async()=>{oldVerify.disabled=true;try{const code=normalized(root.querySelector("#sms-reauth-code").value);const r=await otpRequest(root.dataset.reauthVerify,{code});reauthToken=r.reauthToken;requestButton.disabled=false;setStatus("موبایل فعلی تأیید شد.",true);}catch(_){setStatus(root.dataset.error,false);}finally{oldVerify.disabled=false;}};
        }
        requestButton.addEventListener("click", async function () {
            const value = normalized(phoneInput.value);
            if (!/^(09[0-9]{9}|989[0-9]{9}|\+989[0-9]{9})$/.test(value)) {
                setStatus(root.dataset.invalid, false);
                return;
            }
            requestButton.disabled = true;
            verification.hidden = true;
            codeInput.value = "";
            pendingPhone = "";
            try {
                await otpRequest(root.dataset.requestUrl, { phone: value, reauthToken });
                pendingPhone = value;
                verification.hidden = false;
                setStatus(root.dataset.requested, true);
            } catch (_) {
                setStatus(root.dataset.error, false);
            } finally {
                requestButton.disabled = false;
            }
        });

        verifyButton.addEventListener("click", async function () {
            const code = normalized(codeInput.value);
            if (!pendingPhone || !/^[0-9]{6}$/.test(code)) {
                setStatus(root.dataset.error, false);
                return;
            }
            verifyButton.disabled = true;
            try {
                await otpRequest(root.dataset.verifyUrl, { phone: pendingPhone, code, reauthToken });
                window.location.assign(root.dataset.loginUrl);
            } catch (_) {
                setStatus(root.dataset.error, false);
            } finally {
                verifyButton.disabled = false;
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSmsPhoneEditor, { once: true });
    } else {
        initSmsPhoneEditor();
    }
})();
</script>
