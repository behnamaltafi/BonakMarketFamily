@model SmsOtpLoginModel

@{
    Layout = "_Layout";
    Assets.AppendTitleParts(T("Plugins.Identity.Customer.Otp.LoginTitle").Value);
    Assets.AddMetaRobots();
}

<div class="page login-page">
    <div class="row justify-content-center my-4">
        <div class="col-12 col-md-8 col-xl-6">
            <h1 class="page-title">@T("Plugins.Identity.Customer.Otp.LoginTitle")</h1>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted">@T("Plugins.Identity.Customer.Otp.LoginHint")</p>

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
                    }

                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                    @if (!Model.CodeRequested)
                    {
                        <form asp-controller="SmsLogin" asp-action="RequestCode" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <input type="hidden" asp-for="CheckoutAsGuest" />
                            <div class="form-floating mb-3">
                                <input asp-for="Phone" class="form-control" inputmode="tel"
                                       autocomplete="tel" placeholder="09123456789" maxlength="16" dir="ltr" autofocus required />
                                <label asp-for="Phone">@T("Plugins.Identity.Customer.Otp.PhoneLabel")</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">@T("Plugins.Identity.Customer.Otp.SendCode")</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="SmsLogin" asp-action="VerifyCode" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <input type="hidden" asp-for="CheckoutAsGuest" />
                            <div class="form-floating mb-3">
                                <input asp-for="Phone" class="form-control" inputmode="tel"
                                       autocomplete="tel" placeholder="09123456789" maxlength="16" dir="ltr" readonly />
                                <label asp-for="Phone">@T("Plugins.Identity.Customer.Otp.PhoneLabel")</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Code" class="form-control" inputmode="numeric"
                                       autocomplete="one-time-code" placeholder="123456"
                                       pattern="[0-9]{6}" maxlength="6" dir="ltr" autofocus required />
                                <label asp-for="Code">@T("Plugins.Identity.Customer.Otp.CodeLabel")</label>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100">@T("Plugins.Identity.Customer.Otp.SignIn")</button>
                        </form>
                        <form asp-controller="SmsLogin" asp-action="RequestCode" method="post" class="mt-3">
                            <input type="hidden" name="Phone" value="@Model.Phone" />
                            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                            <input type="hidden" name="CheckoutAsGuest" value="@Model.CheckoutAsGuest" />
                            <button id="otp-resend" type="submit" class="btn btn-link p-0" disabled="@(Model.RetryAfterSeconds > 0)" data-seconds="@Model.RetryAfterSeconds">@T("Plugins.Identity.Customer.Otp.SendCode")</button>
                            <span id="otp-resend-timer" aria-live="off"></span>
                            <a asp-controller="SmsLogin" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl" asp-route-checkoutAsGuest="@Model.CheckoutAsGuest" class="ml-3">@T("Plugins.Identity.Customer.Otp.ChangePhone")</a>
                        </form>
                    }
                    <hr />
                    <div class="mt-3 d-flex flex-wrap justify-content-between">
                        <a asp-route="Login" asp-route-method="password" asp-route-returnUrl="@Model.ReturnUrl" asp-route-checkoutAsGuest="@Model.CheckoutAsGuest">@T("Plugins.Identity.Customer.Otp.PasswordLogin")</a>
                        <a asp-controller="SmsLogin" asp-action="Enroll">@T("Plugins.Identity.Customer.Otp.EnrollLink")</a>
                    </div>
                    <div class="mt-3 d-flex flex-wrap justify-content-between">
                        @if (Model.CheckoutAsGuest)
                        {
                            <a asp-route="Checkout">@T("Account.Login.CheckoutAsGuest")</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const button = document.getElementById('otp-resend');
    const timer = document.getElementById('otp-resend-timer');
    if (!button || !timer) return;
    const deadline = Date.now() + Number(button.dataset.seconds || 0) * 1000;
    function tick() {
        const seconds = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
        button.disabled = seconds > 0;
        timer.textContent = seconds > 0 ? ' (' + Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0') + ')' : '';
        if (seconds > 0) window.setTimeout(tick, 250);
    }
    tick();
})();
</script>
