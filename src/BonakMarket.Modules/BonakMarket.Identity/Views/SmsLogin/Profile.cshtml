@model SmsProfileModel

@{
    Layout = "_Layout";
    Assets.AppendTitleParts(T("Plugins.Identity.Customer.Otp.ProfileTitle").Value);
    Assets.AddMetaRobots();
}

<div class="page login-page">
    <div class="row justify-content-center my-4">
        <div class="col-12 col-md-8 col-xl-6">
            <h1 class="page-title">@T("Plugins.Identity.Customer.Otp.ProfileTitle")</h1>
            <p class="text-muted">@T("Plugins.Identity.Customer.Otp.ProfileHint")</p>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <form asp-controller="SmsLogin" asp-action="SaveProfile" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="form-floating mb-3">
                            <input asp-for="Phone" class="form-control" dir="ltr" readonly />
                            <label asp-for="Phone">@T("Plugins.Identity.Customer.Otp.PhoneLabel")</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="FirstName" class="form-control" maxlength="225" />
                            <label asp-for="FirstName">@T("Plugins.Identity.Customer.Otp.FirstNameLabel")</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="LastName" class="form-control" maxlength="225" />
                            <label asp-for="LastName">@T("Plugins.Identity.Customer.Otp.LastNameLabel")</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" maxlength="500"
                                   autocomplete="email" />
                            <label asp-for="Email">@T("Plugins.Identity.Customer.Otp.EmailOptionalLabel")</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="NationalCode" class="form-control" maxlength="10" inputmode="numeric" dir="ltr" />
                            <label asp-for="NationalCode">کد ملی (اختیاری)</label>
                            <span asp-validation-for="NationalCode" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="GuildId" class="form-label">صنف فعالیت</label>
                            <select asp-for="GuildId" class="form-select" required>
                                <option value="">انتخاب صنف</option>
                                @foreach (var guild in Model.Guilds)
                                {
                                    <option value="@guild.Id">@guild.Title</option>
                                }
                            </select>
                            <span asp-validation-for="GuildId" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            @T("Plugins.Identity.Customer.Otp.SaveProfile")
                        </button>
                    </form>
                    <hr />
                    <partial name="_CustomerAddresses" />
                    <hr />
                    @await Component.InvokeAsync("SmsProfileLink")
                </div>
            </div>
        </div>
    </div>
</div>
