@model SmsProfileModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AddressAntiforgery
@{ var csrf = AddressAntiforgery.GetAndStoreTokens(Context); }
<div id="customer-address-editor" data-base="@Url.Content("~/sms-login/account/addresses")"
     data-location-base="@Url.Content("~/api/identity/v1/locations")" data-csrf-header="@csrf.HeaderName" data-csrf-token="@csrf.RequestToken" data-phone="@Model.Phone">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4>آدرس‌های من (اختیاری)</h4>
        <button type="button" class="btn btn-outline-primary" data-add>افزودن آدرس</button>
    </div>
    <div data-list></div>
    <div data-more></div>
    <div data-edit hidden class="border rounded p-3 my-3">
        <div data-fields></div>
        <button type="button" class="btn btn-primary" data-save>ذخیره آدرس</button>
        <button type="button" class="btn btn-secondary" data-cancel>انصراف</button>
    </div>
    <p data-status role="status" aria-live="polite"></p>
</div>
<script>
(function(){
    const root=document.getElementById("customer-address-editor");
    if(!root || root.dataset.initialized) return;
    root.dataset.initialized="true";
    const list=root.querySelector("[data-list]"), edit=root.querySelector("[data-edit]"),
        fields=root.querySelector("[data-fields]"), status=root.querySelector("[data-status]"),
        more=root.querySelector("[data-more]");
    const labels={firstName:"نام گیرنده",lastName:"نام خانوادگی گیرنده",phoneNumber:"شماره تماس",
        stateProvinceId:"استان",cityId:"شهر",address1:"آدرس",address2:"ادامه آدرس",
        zipPostalCode:"کد پستی",company:"شرکت",salutation:"عنوان خطاب",title:"عنوان",faxNumber:"فکس"};
    let current=null, configuration=null, page=1;
    function el(tag,text,cls){const x=document.createElement(tag);if(text)x.textContent=text;if(cls)x.className=cls;return x;}
    function message(text,ok){status.textContent=text;status.className=ok?"text-success":"text-danger";}
    async function call(path,method="GET",body){
        const headers={};
        if(method!=="GET"){
            headers[root.dataset.csrfHeader]=root.dataset.csrfToken;
            headers["Content-Type"]="application/json";
        }
        const response=await fetch(root.dataset.base+path,{method,headers,credentials:"same-origin",cache:"no-store",body:body===undefined?undefined:JSON.stringify(body)});
        if(!response.ok){let error={};try{error=await response.json();}catch(_){};throw Error(error.errors?Object.entries(error.errors).map(([k,v])=>(labels[k]||k)+": "+v.join(", ")).join(" | "):error.code||"خطا در انجام عملیات ("+response.status+")");}
        return response.status===204?null:response.json();
    }
    function button(text,action){const b=el("button",text,"btn btn-sm btn-outline-secondary me-2");b.type="button";b.onclick=async()=>{try{await action();}catch(e){message(e.message,false);}};return b;}
    async function load(){
        const result=await call("?page="+page+"&pageSize=20");
        list.replaceChildren();more.replaceChildren();
        for(const a of result.items){
            const box=el("div",null,"border rounded p-3 mb-2");
            box.append(el("strong",[a.stateProvinceName,a.city,a.address1].filter(Boolean).join("، ")));
            box.append(el("p",[a.firstName,a.lastName,a.phoneNumber,a.zipPostalCode].filter(Boolean).join(" - "),"mb-2"));
            if(a.isDefaultBilling&&a.isDefaultShipping)box.append(el("span","پیش‌فرض","badge bg-success me-2"));
            else box.append(button("پیش‌فرض",async()=>{await call("/"+a.id+"/default","PUT");await load();}));
            box.append(button("ویرایش",()=>open(a)),button("حذف",async()=>{if(confirm("آدرس حذف شود؟")){await call("/"+a.id,"DELETE");page=1;await load();}}));list.append(box);
        }
        if(page>1)more.append(button("قبلی",async()=>{page--;await load();}));
        if(page*20<result.totalCount)more.append(button("بعدی",async()=>{page++;await load();}));
    }
    async function open(a){
        configuration=await call("/settings");current=a;
        fields.replaceChildren();
        fields.append(el("p",configuration.country.name,"text-muted"));
        for(const [name,label] of Object.entries(labels)){
            const rule=configuration.fields[name];if(!rule?.enabled)continue;
            const wrap=el("div",null,"mb-2");wrap.append(el("label",label+(rule.required?" *":""),"form-label"));
            const input=el(name==="stateProvinceId"||name==="cityId"||name==="salutation"?"select":"input",null,"form-control");
            input.dataset.field=name;input.required=rule.required;
            if(name==="stateProvinceId"||name==="salutation"){
                const opt=el("option","انتخاب کنید");opt.value="";input.append(opt);
                for(const item of name==="stateProvinceId"?configuration.provinces:configuration.salutations){const o=el("option",typeof item==="string"?item:item.name);o.value=typeof item==="string"?item:item.id;input.append(o);}
            }
            if(name==="stateProvinceId" && a?.stateProvinceId && !configuration.provinces.some(p=>p.id===a.stateProvinceId)){
                const old=el("option",a.stateProvinceName||String(a.stateProvinceId));old.value=a.stateProvinceId;input.append(old);
            }
            input.value=a?.[name]??(name==="firstName"?document.querySelector("[name=FirstName]")?.value:name==="lastName"?document.querySelector("[name=LastName]")?.value:name==="phoneNumber"?root.dataset.phone:"")??"";
            wrap.append(input);fields.append(wrap);
        }
        const provinceSelect=fields.querySelector('[data-field="stateProvinceId"]'), citySelect=fields.querySelector('[data-field="cityId"]');
        let sequence=0;
        async function loadCities(initial){
            const revision=++sequence, province=provinceSelect.value;
            citySelect.replaceChildren();const empty=el("option","انتخاب کنید");empty.value="";citySelect.append(empty);
            if(!province)return;
            const cities=[];
            let cityPage=1, hasNextPage;
            do{
                const response=await fetch(root.dataset.locationBase+"/provinces/"+encodeURIComponent(province)+"/cities?page="+cityPage+"&pageSize=100",{credentials:"same-origin"});
                if(!response.ok)throw Error("Unable to load cities");
                const result=await response.json();if(revision!==sequence)return;
                cities.push(...result.items);
                hasNextPage=result.hasNextPage;cityPage++;
            }while(hasNextPage);
            for(const c of cities){const option=el("option",c.name);option.value=c.id;citySelect.append(option);}
            if(initial){
                const found=cities.find(c=>c.id===a?.cityId||c.name===a?.city);
                if(found)citySelect.value=found.id;
                else if(a?.city && !a.cityId){
                    const legacy=el("option",a.city);legacy.value="legacy";citySelect.append(legacy);citySelect.value="legacy";
                }
            }
        }
        provinceSelect.onchange=()=>loadCities(false).catch(e=>message(e.message,false));
        await loadCities(true);
        const defaultLabel=el("label"," پیش‌فرض","form-label");const check=el("input");check.type="checkbox";check.dataset.field="isDefault";check.checked=!!(a?.isDefaultBilling&&a?.isDefaultShipping);defaultLabel.prepend(check);fields.append(defaultLabel);edit.hidden=false;
    }
    root.querySelector("[data-add]").onclick=()=>open(null).catch(e=>message(e.message,false));
    root.querySelector("[data-cancel]").onclick=()=>{edit.hidden=true;};
    root.querySelector("[data-save]").onclick=async function(){
        this.disabled=true;
        try{
            const input={};
            for(const x of fields.querySelectorAll("[data-field]")){
                if(!x.reportValidity())return;
                if(x.dataset.field==="cityId" && x.value==="legacy"){input.cityId=null;input.city=current.city;continue;}
                input[x.dataset.field]=x.type==="checkbox"?x.checked:["stateProvinceId","cityId"].includes(x.dataset.field)?Number(x.value)||null:x.value||null;
            }
            await call(current?"/"+current.id:"",current?"PUT":"POST",input);
            edit.hidden=true;page=1;await load();message("آدرس ذخیره شد.",true);
        }catch(e){message(e.message,false);}finally{this.disabled=false;}
    };
    load().catch(e=>message(e.message,false));
})();
</script>
