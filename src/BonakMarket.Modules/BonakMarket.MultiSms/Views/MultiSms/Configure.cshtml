@model ConfigurationModel
@{
    Layout = "_ConfigureModule";
}
<widget target-zone="admin_button_toolbar_before">
    <button id="SaveConfigButton" name="save" value="save" data-target="#sms-gateway-settings" type="submit" class="btn btn-primary" form="sms-gateway-settings"><icon name="check"/> @T("Admin.Common.Save")</button>
</widget>
<h3>@T("Plugins.Sms.MultiSms.Routing.Title")</h3>
<p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.DeliveryIntro")</p>
<p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.NotTestedHint")</p>
@if (!Model.DeliveryRoutingConfigured)
{
    <div class="alert alert-warning">@T("Plugins.Sms.MultiSms.Routing.DeliveryReset")</div>
}
<div class="d-flex mb-3">
    <a asp-action="TestCenter" class="btn btn-outline-primary mr-2">@T("Plugins.Sms.MultiSms.Routing.TestCenter")</a>
    <a asp-controller="MultiSms" asp-action="History" asp-area="Admin" class="btn btn-outline-secondary">@T("Plugins.Sms.MultiSms.HistoryTitle")</a>
    @if (Model.DevelopmentMode)
    {
        <a asp-controller="MultiSms" asp-action="DevelopmentInbox" asp-area="Admin" class="btn btn-outline-primary ml-2">@T("Plugins.Sms.MultiSms.Routing.DevInbox")</a>
    }
</div>
<form id="sms-gateway-settings" asp-action="Configure" method="post" autocomplete="off">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-check mb-2"><input asp-for="Enabled" class="form-check-input"/><label asp-for="Enabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Enabled")</label></div>
    @if (Model.DevelopmentMode) { <div class="form-check mb-2"><input asp-for="MockEnabled" class="form-check-input"/><label asp-for="MockEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Mock")</label></div> }
    <div class="row"><div class="col-md-6 mb-3"><div class="border rounded p-3 h-100"><h5>@T("Plugins.Sms.MultiSms.Routing.TemplateRoute")</h5>
<div class="form-group"><label asp-for="TemplatePrimary">@T("Plugins.Sms.MultiSms.Routing.Primary")</label><select asp-for="TemplatePrimary" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="TemplatePrimary" class="text-danger"></span></div>
<div class="form-check mb-2"><input asp-for="TemplateFailover" class="form-check-input"/><label asp-for="TemplateFailover" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.SafeFailover")</label></div>
<div class="form-group"><label asp-for="TemplateFallback1">@T("Plugins.Sms.MultiSms.Routing.Fallback1")</label><select asp-for="TemplateFallback1" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="TemplateFallback1" class="text-danger"></span></div>
<div class="form-group"><label asp-for="TemplateFallback2">@T("Plugins.Sms.MultiSms.Routing.Fallback2")</label><select asp-for="TemplateFallback2" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="TemplateFallback2" class="text-danger"></span></div></div></div><div class="col-md-6 mb-3"><div class="border rounded p-3 h-100"><h5>@T("Plugins.Sms.MultiSms.Routing.FreeTextRoute")</h5>
<div class="form-group"><label asp-for="FreeTextPrimary">@T("Plugins.Sms.MultiSms.Routing.Primary")</label><select asp-for="FreeTextPrimary" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="FreeTextPrimary" class="text-danger"></span></div>
<div class="form-check mb-2"><input asp-for="FreeTextFailover" class="form-check-input"/><label asp-for="FreeTextFailover" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.SafeFailover")</label></div>
<div class="form-group"><label asp-for="FreeTextFallback1">@T("Plugins.Sms.MultiSms.Routing.Fallback1")</label><select asp-for="FreeTextFallback1" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="FreeTextFallback1" class="text-danger"></span></div>
<div class="form-group"><label asp-for="FreeTextFallback2">@T("Plugins.Sms.MultiSms.Routing.Fallback2")</label><select asp-for="FreeTextFallback2" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="FreeTextFallback2" class="text-danger"></span></div></div></div></div>
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><a class="nav-link active" id="sms-tab-kave" data-toggle="tab" href="#sms-kave" role="tab" aria-controls="sms-kave" aria-selected="true">Kavenegar</a></li>
        <li class="nav-item"><a class="nav-link " id="sms-tab-meli" data-toggle="tab" href="#sms-meli" role="tab" aria-controls="sms-meli" aria-selected="false">Melipayamak</a></li>
        <li class="nav-item"><a class="nav-link " id="sms-tab-ir" data-toggle="tab" href="#sms-ir" role="tab" aria-controls="sms-ir" aria-selected="false">SMS.ir</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="MultiSms" asp-action="Templates" asp-area="Admin">@T("Plugins.Sms.MultiSms.Routing.Templates")</a></li>
        <li class="nav-item"><a class="nav-link " id="sms-tab-history" data-toggle="tab" href="#sms-history" role="tab" aria-controls="sms-history" aria-selected="false">@T("Plugins.Sms.MultiSms.Routing.History")</a></li>
    </ul>
    <p class="text-muted"><a asp-action="Templates">@T("Plugins.Sms.MultiSms.Routing.ManageTemplates")</a></p>
    <div class="tab-content border rounded p-3">
<div id="sms-kave" class="tab-pane show active" role="tabpanel" aria-labelledby="sms-tab-kave"><div class="d-flex flex-wrap align-items-center mb-3"><small class="text-muted mr-2">@T("Plugins.Sms.MultiSms.Routing.SavedState")</small><span class="badge @(Model.FreeTextReadyProviders.Contains("Kavenegar") ? "badge-success" : "badge-secondary") mr-2">@T("Plugins.Sms.MultiSms.Routing.FreeText"): @T(Model.FreeTextReadyProviders.Contains("Kavenegar") ? "Plugins.Sms.MultiSms.Routing.Ready" : "Plugins.Sms.MultiSms.Routing.NotReady")</span><span class="badge @(Model.TemplateReadyProviders.Contains("Kavenegar") ? "badge-success" : "badge-secondary") mr-2">@T("Plugins.Sms.MultiSms.Routing.ProviderTemplateCapability"): @T(Model.TemplateReadyProviders.Contains("Kavenegar") ? "Plugins.Sms.MultiSms.Routing.Ready" : "Plugins.Sms.MultiSms.Routing.NotReady")</span><a asp-action="TestCenter" asp-route-provider="Kavenegar" class="btn btn-sm btn-outline-secondary">@T("Plugins.Sms.MultiSms.Routing.TestProvider")</a></div>
@if (Model.TemplateProviderIssues.GetValueOrDefault("Kavenegar") is string templateIssuekave)
{
    <p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.Template"): @T("Plugins.Sms.MultiSms.Readiness." + templateIssuekave)</p>
}
@if (Model.FreeTextProviderIssues.GetValueOrDefault("Kavenegar") is string freeIssuekave)
{
    <p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.FreeText"): @T("Plugins.Sms.MultiSms.Readiness." + freeIssuekave)</p>
}
<div class="form-check mb-2"><input asp-for="KavenegarEnabled" class="form-check-input"/><label asp-for="KavenegarEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Kave")</label></div>
<div class="form-group"><label asp-for="NewKavenegarApiKey">@T("Plugins.Sms.MultiSms.Routing.ApiKey")</label><input asp-for="NewKavenegarApiKey" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewKavenegarApiKey" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasKavenegarApiKey ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small>
<div class="form-check mb-2"><input asp-for="ClearKavenegarApiKey" class="form-check-input"/><label asp-for="ClearKavenegarApiKey" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Clear")</label></div>
<hr/><h5>@T("Plugins.Sms.MultiSms.Routing.FreeText")</h5>
<div class="form-check mb-2"><input asp-for="KavenegarFreeTextEnabled" class="form-check-input"/><label asp-for="KavenegarFreeTextEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.FreeTextEnabled")</label></div>
<div class="form-group"><label asp-for="KavenegarSender">@T("Plugins.Sms.MultiSms.Routing.Sender")</label><input asp-for="KavenegarSender" type="text" class="form-control" /><span asp-validation-for="KavenegarSender" class="text-danger"></span></div>
<hr/><h5>@T("Plugins.Sms.MultiSms.Routing.Template")</h5>
<div class="form-check mb-2"><input asp-for="KavenegarTemplateEnabled" class="form-check-input"/><label asp-for="KavenegarTemplateEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.TemplateEnabled")</label></div>
</div>
<div id="sms-meli" class="tab-pane " role="tabpanel" aria-labelledby="sms-tab-meli"><div class="d-flex flex-wrap align-items-center mb-3"><small class="text-muted mr-2">@T("Plugins.Sms.MultiSms.Routing.SavedState")</small><span class="badge @(Model.FreeTextReadyProviders.Contains("Melipayamak") ? "badge-success" : "badge-secondary") mr-2">@T("Plugins.Sms.MultiSms.Routing.FreeText"): @T(Model.FreeTextReadyProviders.Contains("Melipayamak") ? "Plugins.Sms.MultiSms.Routing.Ready" : "Plugins.Sms.MultiSms.Routing.NotReady")</span><span class="badge @(Model.TemplateReadyProviders.Contains("Melipayamak") ? "badge-success" : "badge-secondary") mr-2">@T("Plugins.Sms.MultiSms.Routing.ProviderTemplateCapability"): @T(Model.TemplateReadyProviders.Contains("Melipayamak") ? "Plugins.Sms.MultiSms.Routing.Ready" : "Plugins.Sms.MultiSms.Routing.NotReady")</span><a asp-action="TestCenter" asp-route-provider="Melipayamak" class="btn btn-sm btn-outline-secondary">@T("Plugins.Sms.MultiSms.Routing.TestProvider")</a></div>
@if (Model.TemplateProviderIssues.GetValueOrDefault("Melipayamak") is string templateIssuemeli)
{
    <p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.Template"): @T("Plugins.Sms.MultiSms.Readiness." + templateIssuemeli)</p>
}
@if (Model.FreeTextProviderIssues.GetValueOrDefault("Melipayamak") is string freeIssuemeli)
{
    <p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.FreeText"): @T("Plugins.Sms.MultiSms.Readiness." + freeIssuemeli)</p>
}
<div class="form-check mb-2"><input asp-for="MelipayamakEnabled" class="form-check-input"/><label asp-for="MelipayamakEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Meli")</label></div>
<div class="form-group"><label asp-for="MelipayamakAuthMode">@T("Plugins.Sms.MultiSms.Routing.AuthMode")</label><select asp-for="MelipayamakAuthMode" class="form-control"><option value="Console">@T("Plugins.Sms.MultiSms.Routing.Console")</option><option value="Legacy">@T("Plugins.Sms.MultiSms.Routing.Legacy")</option></select></div><div id="sms-meli-console">
<div class="form-group"><label asp-for="NewMelipayamakApiToken">@T("Plugins.Sms.MultiSms.Routing.Console")</label><input asp-for="NewMelipayamakApiToken" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewMelipayamakApiToken" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasMelipayamakApiToken ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small>
<div class="form-check mb-2"><input asp-for="ClearMelipayamakApiToken" class="form-check-input"/><label asp-for="ClearMelipayamakApiToken" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Clear")</label></div></div><div id="sms-meli-legacy">
<div class="form-group"><label asp-for="MelipayamakUsername">@T("Plugins.Sms.MultiSms.Routing.Username")</label><input asp-for="MelipayamakUsername" type="text" class="form-control" /><span asp-validation-for="MelipayamakUsername" class="text-danger"></span></div>
<div class="form-group"><label asp-for="NewMelipayamakPassword">@T("Plugins.Sms.MultiSms.Routing.LegacyKey")</label><input asp-for="NewMelipayamakPassword" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewMelipayamakPassword" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasMelipayamakPassword ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small>
<div class="form-check mb-2"><input asp-for="ClearMelipayamakPassword" class="form-check-input"/><label asp-for="ClearMelipayamakPassword" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Clear")</label></div></div>
<hr/><h5>@T("Plugins.Sms.MultiSms.Routing.FreeText")</h5>
<div class="form-check mb-2"><input asp-for="MelipayamakFreeTextEnabled" class="form-check-input"/><label asp-for="MelipayamakFreeTextEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.FreeTextEnabled")</label></div>
<div class="form-group"><label asp-for="MelipayamakSender">@T("Plugins.Sms.MultiSms.Routing.Sender")</label><input asp-for="MelipayamakSender" type="text" class="form-control" /><span asp-validation-for="MelipayamakSender" class="text-danger"></span></div>
<hr/><h5>@T("Plugins.Sms.MultiSms.Routing.Template")</h5>
<div class="form-check mb-2"><input asp-for="MelipayamakTemplateEnabled" class="form-check-input"/><label asp-for="MelipayamakTemplateEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.TemplateEnabled")</label></div>
</div>
<div id="sms-ir" class="tab-pane " role="tabpanel" aria-labelledby="sms-tab-ir"><div class="d-flex flex-wrap align-items-center mb-3"><small class="text-muted mr-2">@T("Plugins.Sms.MultiSms.Routing.SavedState")</small><span class="badge @(Model.FreeTextReadyProviders.Contains("SmsIr") ? "badge-success" : "badge-secondary") mr-2">@T("Plugins.Sms.MultiSms.Routing.FreeText"): @T(Model.FreeTextReadyProviders.Contains("SmsIr") ? "Plugins.Sms.MultiSms.Routing.Ready" : "Plugins.Sms.MultiSms.Routing.NotReady")</span><span class="badge @(Model.TemplateReadyProviders.Contains("SmsIr") ? "badge-success" : "badge-secondary") mr-2">@T("Plugins.Sms.MultiSms.Routing.ProviderTemplateCapability"): @T(Model.TemplateReadyProviders.Contains("SmsIr") ? "Plugins.Sms.MultiSms.Routing.Ready" : "Plugins.Sms.MultiSms.Routing.NotReady")</span><a asp-action="TestCenter" asp-route-provider="SmsIr" class="btn btn-sm btn-outline-secondary">@T("Plugins.Sms.MultiSms.Routing.TestProvider")</a></div>
@if (Model.TemplateProviderIssues.GetValueOrDefault("SmsIr") is string templateIssueir)
{
    <p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.Template"): @T("Plugins.Sms.MultiSms.Readiness." + templateIssueir)</p>
}
@if (Model.FreeTextProviderIssues.GetValueOrDefault("SmsIr") is string freeIssueir)
{
    <p class="text-muted">@T("Plugins.Sms.MultiSms.Routing.FreeText"): @T("Plugins.Sms.MultiSms.Readiness." + freeIssueir)</p>
}
<div class="form-check mb-2"><input asp-for="SmsIrEnabled" class="form-check-input"/><label asp-for="SmsIrEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Ir")</label></div>
<div class="form-group"><label asp-for="NewSmsIrApiKey">@T("Plugins.Sms.MultiSms.Routing.ApiKey")</label><input asp-for="NewSmsIrApiKey" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewSmsIrApiKey" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasSmsIrApiKey ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small>
<div class="form-check mb-2"><input asp-for="ClearSmsIrApiKey" class="form-check-input"/><label asp-for="ClearSmsIrApiKey" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Clear")</label></div>
<hr/><h5>@T("Plugins.Sms.MultiSms.Routing.FreeText")</h5>
<div class="form-check mb-2"><input asp-for="SmsIrFreeTextEnabled" class="form-check-input"/><label asp-for="SmsIrFreeTextEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.FreeTextEnabled")</label></div>
<div class="form-group"><label asp-for="SmsIrLineNumber">@T("Plugins.Sms.MultiSms.Routing.Line")</label><input asp-for="SmsIrLineNumber" type="number" class="form-control" min="1"/><span asp-validation-for="SmsIrLineNumber" class="text-danger"></span></div>
<hr/><h5>@T("Plugins.Sms.MultiSms.Routing.Template")</h5>
<div class="form-check mb-2"><input asp-for="SmsIrTemplateEnabled" class="form-check-input"/><label asp-for="SmsIrTemplateEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.TemplateEnabled")</label></div>

</div>
<div id="sms-history" class="tab-pane " role="tabpanel" aria-labelledby="sms-tab-history">
<div class="form-check mb-2"><input asp-for="HistoryEnabled" class="form-check-input"/><label asp-for="HistoryEnabled" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.HistoryEnabled")</label></div>
<div class="form-group"><label asp-for="HistoryRetentionDays">@T("Plugins.Sms.MultiSms.Routing.Retention")</label><input asp-for="HistoryRetentionDays" type="number" class="form-control" min="1" max="3650"/><span asp-validation-for="HistoryRetentionDays" class="text-danger"></span></div>
<div class="form-check mb-2"><input asp-for="ShowOtpCodeInHistory" class="form-check-input"/><label asp-for="ShowOtpCodeInHistory" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.ShowOtp")</label></div>
<div class="form-check mb-2"><input asp-for="StoreNonOtpMessageBody" class="form-check-input"/><label asp-for="StoreNonOtpMessageBody" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.StoreBody")</label></div></div>
    </div>
</form>
<script>
(function () {
    const mode = document.getElementById('MelipayamakAuthMode');
    function syncMode() {
        document.getElementById('sms-meli-console').hidden = mode.value !== 'Console';
        document.getElementById('sms-meli-legacy').hidden = mode.value !== 'Legacy';
    }
    mode.addEventListener('change', syncMode); syncMode();
    for (const prefix of ['Template', 'FreeText']) {
        const toggle = document.getElementById(prefix + 'Failover');
        function sync() {
            for (const suffix of ['Fallback1','Fallback2'])
                document.getElementById(prefix + suffix).disabled = !toggle.checked;
        }
        toggle.addEventListener('change', sync); sync();
    }
})();
</script>
