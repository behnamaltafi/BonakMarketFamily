@model ConfigurationModel
@{
    Layout = "_ConfigureModule";
}
<widget target-zone="admin_button_toolbar_before">
    <button id="SaveConfigButton" type="submit" class="btn btn-primary" form="sms-gateway-settings"><icon name="check"/> @T("Admin.Common.Save")</button>
</widget>
<h3>SMS Gateway</h3>
<p class="text-muted">OTP uses approved service templates only. General SMS uses free text. Save settings before testing.</p>
@if (!Model.RoutingConfigured)
{
    <div class="alert alert-warning">Reconfiguration required. Existing SMS routes are disabled until saved again. Enter provider credentials and configure routes.</div>
}
<div class="d-flex mb-3">
    <a asp-controller="MultiSms" asp-action="History" asp-area="Admin" class="btn btn-outline-secondary">@T("Plugins.Sms.MultiSms.HistoryTitle")</a>
    @if (Model.DevelopmentMode)
    {
        <a asp-controller="MultiSms" asp-action="DevelopmentInbox" asp-area="Admin" class="btn btn-outline-primary ml-2">Development inbox</a>
    }
</div>
<form id="sms-gateway-settings" asp-action="Configure" method="post" autocomplete="off">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-check mb-2"><input asp-for="Enabled" class="form-check-input"/><label asp-for="Enabled" class="form-check-label">Enable SMS Gateway</label></div>
    @if (Model.DevelopmentMode) { <div class="form-check mb-2"><input asp-for="MockEnabled" class="form-check-input"/><label asp-for="MockEnabled" class="form-check-label">Enable development-only Mock provider</label></div> }
    <div class="row"><div class="col-md-6 mb-3"><div class="border rounded p-3 h-100"><h5>OTP routing — service templates</h5><div class="form-group"><label asp-for="OtpPrimary">Primary</label><select asp-for="OtpPrimary" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="OtpPrimary" class="text-danger"></span></div>
<div class="form-check mb-2"><input asp-for="OtpFailover" class="form-check-input"/><label asp-for="OtpFailover" class="form-check-label">Enable safe failover</label></div><div class="form-group"><label asp-for="OtpFallback1">Fallback 1</label><select asp-for="OtpFallback1" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="OtpFallback1" class="text-danger"></span></div>
<div class="form-group"><label asp-for="OtpFallback2">Fallback 2</label><select asp-for="OtpFallback2" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="OtpFallback2" class="text-danger"></span></div></div></div><div class="col-md-6 mb-3"><div class="border rounded p-3 h-100"><h5>General SMS routing — free text</h5><div class="form-group"><label asp-for="GeneralPrimary">Primary</label><select asp-for="GeneralPrimary" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="GeneralPrimary" class="text-danger"></span></div>
<div class="form-check mb-2"><input asp-for="GeneralFailover" class="form-check-input"/><label asp-for="GeneralFailover" class="form-check-label">Enable safe failover</label></div><div class="form-group"><label asp-for="GeneralFallback1">Fallback 1</label><select asp-for="GeneralFallback1" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="GeneralFallback1" class="text-danger"></span></div>
<div class="form-group"><label asp-for="GeneralFallback2">Fallback 2</label><select asp-for="GeneralFallback2" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select><span asp-validation-for="GeneralFallback2" class="text-danger"></span></div></div></div></div>
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><a class="nav-link active" id="sms-tab-kave" data-toggle="tab" data-bs-toggle="tab" href="#sms-kave" role="tab" aria-controls="sms-kave" aria-selected="true">Kavenegar</a></li>
        <li class="nav-item"><a class="nav-link " id="sms-tab-meli" data-toggle="tab" data-bs-toggle="tab" href="#sms-meli" role="tab" aria-controls="sms-meli" aria-selected="false">Melipayamak</a></li>
        <li class="nav-item"><a class="nav-link " id="sms-tab-ir" data-toggle="tab" data-bs-toggle="tab" href="#sms-ir" role="tab" aria-controls="sms-ir" aria-selected="false">SMS.ir</a></li>
        <li class="nav-item"><a class="nav-link " id="sms-tab-history" data-toggle="tab" data-bs-toggle="tab" href="#sms-history" role="tab" aria-controls="sms-history" aria-selected="false">History settings</a></li>
    </ul>
    <div class="tab-content border rounded p-3">
<div id="sms-kave" class="tab-pane show active" role="tabpanel" aria-labelledby="sms-tab-kave"><div class="form-check mb-2"><input asp-for="KavenegarEnabled" class="form-check-input"/><label asp-for="KavenegarEnabled" class="form-check-label">Enable Kavenegar</label></div><div class="form-group"><label asp-for="NewKavenegarApiKey">API key</label><input asp-for="NewKavenegarApiKey" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewKavenegarApiKey" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasKavenegarApiKey ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small><div class="form-check mb-2"><input asp-for="ClearKavenegarApiKey" class="form-check-input"/><label asp-for="ClearKavenegarApiKey" class="form-check-label">Clear saved secret</label></div><hr/><h5>General SMS</h5><div class="form-check mb-2"><input asp-for="KavenegarGeneralEnabled" class="form-check-input"/><label asp-for="KavenegarGeneralEnabled" class="form-check-label">Enable general SMS</label></div><div class="form-group"><label asp-for="KavenegarSender">Sender number</label><input asp-for="KavenegarSender" type="text" class="form-control" /><span asp-validation-for="KavenegarSender" class="text-danger"></span></div><hr/><h5>OTP / Verify Lookup</h5><div class="form-check mb-2"><input asp-for="KavenegarOtpEnabled" class="form-check-input"/><label asp-for="KavenegarOtpEnabled" class="form-check-label">Enable OTP</label></div><div class="form-group"><label asp-for="KavenegarOtpTemplate">Approved template name</label><input asp-for="KavenegarOtpTemplate" type="text" class="form-control" /><span asp-validation-for="KavenegarOtpTemplate" class="text-danger"></span></div><small class="text-muted">The code is passed as token.</small></div>
<div id="sms-meli" class="tab-pane " role="tabpanel" aria-labelledby="sms-tab-meli"><div class="form-check mb-2"><input asp-for="MelipayamakEnabled" class="form-check-input"/><label asp-for="MelipayamakEnabled" class="form-check-label">Enable Melipayamak</label></div><div class="form-group"><label asp-for="MelipayamakAuthMode">Authentication mode</label><select asp-for="MelipayamakAuthMode" class="form-control"><option value="Console">Console API Token</option><option value="Legacy">Legacy REST (username + API key)</option></select></div><div id="sms-meli-console"><div class="form-group"><label asp-for="NewMelipayamakApiToken">Console API token</label><input asp-for="NewMelipayamakApiToken" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewMelipayamakApiToken" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasMelipayamakApiToken ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small><div class="form-check mb-2"><input asp-for="ClearMelipayamakApiToken" class="form-check-input"/><label asp-for="ClearMelipayamakApiToken" class="form-check-label">Clear saved secret</label></div></div><div id="sms-meli-legacy"><div class="form-group"><label asp-for="MelipayamakUsername">Username</label><input asp-for="MelipayamakUsername" type="text" class="form-control" /><span asp-validation-for="MelipayamakUsername" class="text-danger"></span></div><div class="form-group"><label asp-for="NewMelipayamakPassword">Legacy API key (password field)</label><input asp-for="NewMelipayamakPassword" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewMelipayamakPassword" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasMelipayamakPassword ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small><div class="form-check mb-2"><input asp-for="ClearMelipayamakPassword" class="form-check-input"/><label asp-for="ClearMelipayamakPassword" class="form-check-label">Clear saved secret</label></div></div><hr/><h5>General SMS</h5><div class="form-check mb-2"><input asp-for="MelipayamakGeneralEnabled" class="form-check-input"/><label asp-for="MelipayamakGeneralEnabled" class="form-check-label">Enable general SMS</label></div><div class="form-group"><label asp-for="MelipayamakSender">Sender number</label><input asp-for="MelipayamakSender" type="text" class="form-control" /><span asp-validation-for="MelipayamakSender" class="text-danger"></span></div><hr/><h5>OTP / shared service line</h5><div class="form-check mb-2"><input asp-for="MelipayamakOtpEnabled" class="form-check-input"/><label asp-for="MelipayamakOtpEnabled" class="form-check-label">Enable OTP</label></div><div class="form-group"><label asp-for="MelipayamakBodyId">Approved Body ID</label><input asp-for="MelipayamakBodyId" type="number" class="form-control" min="1"/><span asp-validation-for="MelipayamakBodyId" class="text-danger"></span></div><small class="text-muted">Use a template with one positional OTP variable.</small></div>
<div id="sms-ir" class="tab-pane " role="tabpanel" aria-labelledby="sms-tab-ir"><div class="form-check mb-2"><input asp-for="SmsIrEnabled" class="form-check-input"/><label asp-for="SmsIrEnabled" class="form-check-label">Enable SMS.ir</label></div><div class="form-group"><label asp-for="NewSmsIrApiKey">API key</label><input asp-for="NewSmsIrApiKey" type="password" class="form-control" autocomplete="new-password" value=""/><span asp-validation-for="NewSmsIrApiKey" class="text-danger"></span></div><small class="text-muted d-block mb-2">@(Model.HasSmsIrApiKey ? T("Plugins.Sms.MultiSms.SecretConfigured") : T("Plugins.Sms.MultiSms.SecretMissing"))</small><div class="form-check mb-2"><input asp-for="ClearSmsIrApiKey" class="form-check-input"/><label asp-for="ClearSmsIrApiKey" class="form-check-label">Clear saved secret</label></div><hr/><h5>General SMS</h5><div class="form-check mb-2"><input asp-for="SmsIrGeneralEnabled" class="form-check-input"/><label asp-for="SmsIrGeneralEnabled" class="form-check-label">Enable general SMS</label></div><div class="form-group"><label asp-for="SmsIrLineNumber">Line number</label><input asp-for="SmsIrLineNumber" type="number" class="form-control" min="1"/><span asp-validation-for="SmsIrLineNumber" class="text-danger"></span></div><hr/><h5>OTP / Verify</h5><div class="form-check mb-2"><input asp-for="SmsIrOtpEnabled" class="form-check-input"/><label asp-for="SmsIrOtpEnabled" class="form-check-label">Enable OTP</label></div><div class="form-group"><label asp-for="SmsIrTemplateId">Approved template ID</label><input asp-for="SmsIrTemplateId" type="number" class="form-control" min="1"/><span asp-validation-for="SmsIrTemplateId" class="text-danger"></span></div><div class="form-group"><label asp-for="SmsIrCodeParameter">Exact template parameter name</label><input asp-for="SmsIrCodeParameter" type="text" class="form-control" /><span asp-validation-for="SmsIrCodeParameter" class="text-danger"></span></div></div>
<div id="sms-history" class="tab-pane " role="tabpanel" aria-labelledby="sms-tab-history"><div class="form-check mb-2"><input asp-for="HistoryEnabled" class="form-check-input"/><label asp-for="HistoryEnabled" class="form-check-label">Enable history</label></div><div class="form-group"><label asp-for="HistoryRetentionDays">Retention (days)</label><input asp-for="HistoryRetentionDays" type="number" class="form-control" min="1" max="3650"/><span asp-validation-for="HistoryRetentionDays" class="text-danger"></span></div><div class="form-check mb-2"><input asp-for="ShowOtpCodeInHistory" class="form-check-input"/><label asp-for="ShowOtpCodeInHistory" class="form-check-label">Show OTP code in history</label></div><div class="form-check mb-2"><input asp-for="StoreNonOtpMessageBody" class="form-check-input"/><label asp-for="StoreNonOtpMessageBody" class="form-check-label">Store ordinary message body</label></div></div>
    </div>
</form>
<hr/>
<h5>Test a specific provider</h5>
<p class="text-muted">Uses saved settings. No failover. OTP test does not create a login challenge.</p>
<form asp-action="TestSms" method="post" autocomplete="off">
    <div class="form-group"><label asp-for="TestProvider">Provider</label><select asp-for="TestProvider" class="form-control"><option value="">—</option>@foreach (var provider in Model.AvailableProviders) { <option value="@provider">@provider</option> }</select></div>
    <div class="form-group"><label asp-for="TestPhone">Recipient</label><input asp-for="TestPhone" type="tel" class="form-control" /><span asp-validation-for="TestPhone" class="text-danger"></span></div>
    <div class="form-group"><label asp-for="TestMessage">General test message</label><textarea asp-for="TestMessage" class="form-control" rows="2"></textarea></div>
    <button type="submit" name="TestOtp" value="false" class="btn btn-secondary">Test General SMS</button>
    <button type="submit" name="TestOtp" value="true" class="btn btn-primary">Test OTP Template</button>
    @if (Model.TestSucceeded.HasValue)
    {
        <div class="alert mt-3 @(Model.TestSucceeded.Value ? "alert-success" : "alert-danger")">@Model.TestResult</div>
    }
</form>
<script>
(function () {
    const mode = document.getElementById('MelipayamakAuthMode');
    function syncMode() {
        document.getElementById('sms-meli-console').hidden = mode.value !== 'Console';
        document.getElementById('sms-meli-legacy').hidden = mode.value !== 'Legacy';
    }
    mode.addEventListener('change', syncMode); syncMode();
    for (const prefix of ['Otp', 'General']) {
        const toggle = document.getElementById(prefix + 'Failover');
        function sync() {
            for (const suffix of ['Fallback1','Fallback2'])
                document.getElementById(prefix + suffix).disabled = !toggle.checked;
        }
        toggle.addEventListener('change', sync); sync();
    }
})();
</script>
