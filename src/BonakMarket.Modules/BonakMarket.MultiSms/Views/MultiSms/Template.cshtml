@model SmsTemplateEditorModel
@{
    Layout = "_ConfigureModule";
    var existing = Model.Id != 0;
    var parameterNames = (Model.Parameters ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
}
<h3>@T("Plugins.Sms.MultiSms.Routing.Templates")</h3>
<a asp-action="Templates" class="btn btn-secondary mb-3">@T("Plugins.Sms.MultiSms.Routing.Templates")</a>
@if (Model.Readiness != null)
{
    <div class="alert @(Model.Readiness.IsReady ? "alert-success" : "alert-warning")">
        @(Model.Readiness.IsReady ? T("Plugins.Sms.MultiSms.Routing.Ready").Value : T("Plugins.Sms.MultiSms.Routing.NotReady").Value)
        @foreach (var issue in Model.Readiness.Issues)
        {
            <div>@(issue.Provider == null ? "" : issue.Provider + ": ")@T("Plugins.Sms.MultiSms.Readiness." + issue.Code)</div>
        }
    </div>
}
<form asp-action="Template" method="post" id="template-edit-form">
    <input asp-for="Id" type="hidden"/>
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 form-group"><label asp-for="Key">@T("Plugins.Sms.MultiSms.Routing.TemplateKey")</label><input asp-for="Key" readonly="@existing" class="form-control" dir="ltr"/></div>
        <div class="col-md-6 form-group"><label asp-for="Title">@T("Plugins.Sms.MultiSms.Routing.TemplateTitle")</label><input asp-for="Title" class="form-control"/></div>
    </div>
    <div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">@T("Plugins.Sms.MultiSms.Routing.Enabled")</label></div>
    @if (existing)
    {
        <input asp-for="IsOtp" type="hidden"/>
        <p>OTP: @(Model.IsOtp ? "✓" : "—")</p>
    }
    else
    {
        <div class="form-check mb-2"><input asp-for="IsOtp" class="form-check-input"/><label asp-for="IsOtp" class="form-check-label">OTP (Code)</label></div>
    }
    <div class="form-group">
        <label asp-for="Parameters">@T("Plugins.Sms.MultiSms.Routing.LogicalParameters")</label>
        <input asp-for="Parameters" readonly="@existing" class="form-control" dir="ltr" placeholder="OrderNumber, TrackingCode"/>
        <small class="text-muted">@T("Plugins.Sms.MultiSms.Routing.ParameterHelp")</small>
    </div>
    <div class="row">
        @for (var i = 0; i < Model.Mappings.Count; i++)
        {
            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 h-100">
                    <h5>@Model.Mappings[i].Provider</h5>
                    @if (Model.Mappings[i].ConfigurationIssue is string issue) { <p class="text-muted small">@T("Plugins.Sms.MultiSms.Readiness." + issue)</p> }
                    <input asp-for="Mappings[i].Provider" type="hidden"/>
                    <div class="form-group"><label asp-for="Mappings[i].ExternalTemplateId">@T("Plugins.Sms.MultiSms.Routing.ExternalTemplateId")</label>
                        <input asp-for="Mappings[i].ExternalTemplateId" class="form-control" dir="ltr"/></div>
                    <div class="form-group">
                        <label>@T("Plugins.Sms.MultiSms.Routing.Slots")</label>
                        <div class="mapping-rows" data-index="@i" data-provider="@Model.Mappings[i].Provider">
                            @foreach (var slot in Model.Mappings[i].ParameterSlots)
                            {
                                <span hidden data-existing-slot="@slot"></span>
                            }
                        </div>
                        <small class="text-muted">@T("Plugins.Sms.MultiSms.Routing.SlotHelpRows")</small>
                    </div>
                </div>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">@T("Admin.Common.Save")</button>
</form>
@if (existing && Model.IsActive)
{
    <a class="btn btn-outline-primary mt-3" asp-action="TestCenter" asp-route-templateKey="@Model.Key">@T("Plugins.Sms.MultiSms.Routing.TestTemplate")</a>
}
<script>
(function () {
    const otp = document.getElementById('IsOtp'), parameters = document.getElementById('Parameters');
    const rows = Array.from(document.querySelectorAll('.mapping-rows'));
    let previousNames = [];
    function sync() {
        const isOtp = otp.type === 'checkbox' ? otp.checked : otp.value.toLowerCase() === 'true';
        if (isOtp) parameters.value = 'Code';
        if (otp.type === 'checkbox') parameters.readOnly = isOtp;
        const names = parameters.value.split(',').map(x => x.trim()).filter(Boolean).slice(0, 10);
        for (const row of rows) {
            const existing = Array.from(row.querySelectorAll('input')).map(x => x.value);
            const initial = Array.from(row.querySelectorAll('[data-existing-slot]')).map(x => x.dataset.existingSlot);
            row.replaceChildren();
            names.forEach((name, j) => {
                const group = document.createElement('div'), label = document.createElement('label'), input = document.createElement('input');
                group.className = 'mb-2'; label.textContent = name;
                input.name = 'Mappings[' + row.dataset.index + '].ParameterSlots[' + j + ']';
                input.className = 'form-control'; input.maxLength = 50; input.dir = 'ltr';
                const priorIndex = previousNames.indexOf(name);
                const prior = priorIndex >= 0 ? existing[priorIndex] : initial[j];
                if (row.dataset.provider === 'Melipayamak') {
                    input.value = isOtp ? '0' : (prior ?? String(j)); input.readOnly = isOtp;
                } else if (row.dataset.provider === 'Kavenegar') {
                    input.value = isOtp ? 'token' : (prior ?? ['token','token2','token3','token10','token20'][j] ?? '');
                    input.readOnly = isOtp;
                } else input.value = prior ?? name;
                group.append(label, input); row.appendChild(group);
            });
        }
        previousNames = names;
    }
    otp.addEventListener('change', sync);
    parameters.addEventListener('change', sync);
    document.getElementById('template-edit-form').addEventListener('submit', () => {
        const names = parameters.value.split(',').map(x => x.trim()).filter(Boolean).slice(0,10);
        if (names.join(',') !== previousNames.join(',')) sync();
    });
    sync();
})();
</script>
