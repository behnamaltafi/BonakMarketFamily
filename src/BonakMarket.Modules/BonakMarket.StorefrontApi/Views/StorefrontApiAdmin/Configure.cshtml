@model WholesaleCardConfigurationModel
@{
    Layout = "_ConfigureModule";
}

<widget target-zone="admin_button_toolbar_before">
    <button id="SaveConfigButton" type="submit" class="btn btn-primary" form="wholesale-card-settings">
        <icon name="check" />
        <span>@T("Admin.Common.Save")</span>
    </button>
</widget>

<form id="wholesale-card-settings" asp-action="Configure" asp-area="Admin" method="post">
    <div asp-validation-summary="All"></div>
    <h3>Wholesale product card</h3>
    <p class="text-muted">These settings apply to all stores. Select native product specifications; no appsettings changes or restart are needed.</p>
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle"><label asp-for="UnitsPerPackageSpecificationId">Units per package</label></div>
            <div class="adminData">
                <select asp-for="UnitsPerPackageSpecificationId" asp-items="Model.PackageSpecifications" class="form-control"></select>
                <span asp-validation-for="UnitsPerPackageSpecificationId"></span>
                <div class="form-text">Choose the specification whose option NumberValue is a positive whole number of individual items per package.</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><label asp-for="ConsumerPriceSpecificationId">Consumer price specification</label></div>
            <div class="adminData">
                <select asp-for="ConsumerPriceSpecificationId" asp-items="Model.ConsumerPriceSpecifications" class="form-control"></select>
                <span asp-validation-for="ConsumerPriceSpecificationId"></span>
                <div class="form-text">Choose a hidden, nonessential, nonfilterable specification whose option NumberValue is the reference price per individual item.</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><label asp-for="ConsumerPriceCurrencyCode">Consumer price currency code</label></div>
            <div class="adminData">
                <input asp-for="ConsumerPriceCurrencyCode" class="form-control" maxlength="3" placeholder="IRR / IRT" dir="ltr" />
                <span asp-validation-for="ConsumerPriceCurrencyCode"></span>
                <div class="form-text">Enter the actual currency of the configured reference amounts. No automatic conversion is performed.</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"></div>
            <div class="adminData">
                <p class="text-muted">Assign exactly one numeric option per product for each selected specification. Missing or ambiguous values remain empty in the customer API. Consumer prices respect catalog price permissions.</p>
                <button type="submit" class="btn btn-primary">@T("Admin.Common.Save")</button>
            </div>
        </div>
    </div>
</form>
