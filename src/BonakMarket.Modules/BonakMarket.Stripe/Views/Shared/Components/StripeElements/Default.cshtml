@model PublicStripeElementsModel

<script src="@Url.Content("~/Modules/BonakMarket.Stripe/BonakMarket.stripe.js")" sm-target-zone="scripts"></script>

@if (Model.IsPaymentSelectionPage)
{
    <div class="opt-form">
        <div class="media">
            <img class="media-object img-fluid mr-3" src="@Url.Content("~/Modules/BonakMarket.Stripe/branding.png")" alt="" />
            <div class="media-body">
                @Html.Raw(T("Plugins.BonakMarket.Stripe.PaymentInfo"))
            </div>
        </div>
    
        @if (Model.PaymentPageButtonMethodsJson != "[]")
        {
            <div id="stripe-express-checkout-element" class="mt-3" style="visibility: hidden"></div>
        }

        <div id="stripe-payment-element" class="mt-3" data-store-payment-selection-url="@Url.Action("StorePaymentMethodId", "Stripe")">
            <!--Stripe.js injects the Payment Element-->
        </div>
    </div>

    <script>
        $(function () {
            if (typeof Stripe !== 'undefined') {
                BonakMarket.Stripe.initPaymentElement('@Model.PublicApiKey', '@StripeHelper.ApiVersion', @Model.Amount, '@Model.Currency', '@Model.CaptureMethod', @Html.Raw(Model.PaymentPageButtonMethodsJson));
            }
            else {
                var script = document.getElementById("stripe-js");
                script.onload = function () {
                    BonakMarket.Stripe.initPaymentElement('@Model.PublicApiKey', '@StripeHelper.ApiVersion', @Model.Amount, '@Model.Currency', '@Model.CaptureMethod', @Html.Raw(Model.PaymentPageButtonMethodsJson));
                };
            }

            BonakMarket.Stripe.initPaymentSelectionPage('@Model.PublicApiKey');
        });
    </script>
}
else 
{
    <div id="stripe-payment-request-button"
         data-create-payment-intent-url="@Url.Action("CreatePaymentIntent", "Stripe")"
         data-get-current-payment-request-url="@Url.Action("GetUpdatePaymentRequest", "Stripe")"
         data-validate-cart-url="@Url.Action("ValidateCart", "Stripe")"
         data-redirect-url="@Url.Action("BillingAddress", "Checkout", new { area = string.Empty })">
         <!-- A Stripe Element will be inserted here. -->
    </div>

    <script>
        $(function () {
            var paymentRequest = @Html.Raw(Model.PaymentRequest);
            if (typeof Stripe !== 'undefined') {
                BonakMarket.Stripe.initWalletButtonElement('@Model.PublicApiKey', paymentRequest, @Model.IsCartPage.ToString().ToLower(), '@StripeHelper.ApiVersion', @Model.CurrencyMinorUnitFactor);
            } 
            else {
                var script = document.getElementById("stripe-js");
                script.onload = function () {
                    BonakMarket.Stripe.initWalletButtonElement('@Model.PublicApiKey', paymentRequest, @Model.IsCartPage.ToString().ToLower(), '@StripeHelper.ApiVersion', @Model.CurrencyMinorUnitFactor);
                };
            }
        });
    </script>
}
