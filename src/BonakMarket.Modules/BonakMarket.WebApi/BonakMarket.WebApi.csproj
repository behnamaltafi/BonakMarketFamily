<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
		<Product>BonakMarket Web API</Product>
		<OutputPath>..\..\BonakMarket.Web\Modules\BonakMarket.WebApi</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<RootNamespace>BonakMarket.Web.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.31" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\BonakMarket.Web\BonakMarket.Web.csproj">
            <Private>False</Private>
            <CopyLocal>False</CopyLocal>
            <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
        </ProjectReference>
    </ItemGroup>
</Project>