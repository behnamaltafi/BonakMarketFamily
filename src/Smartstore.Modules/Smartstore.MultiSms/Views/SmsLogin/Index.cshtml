@model SmsOtpLoginModel

@{
    Assets.AppendTitleParts(T("Plugins.Sms.MultiSms.Otp.LoginTitle").Value);
    Assets.AddMetaRobots();
}

<div class="page login-page">
    <div class="row mb-4">
        <div class="col-12 col-md-8 offset-md-2 col-xl-6 offset-xl-3">
            <h1 class="page-title">@T("Plugins.Sms.MultiSms.Otp.LoginTitle")</h1>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted">@T("Plugins.Sms.MultiSms.Otp.LoginHint")</p>

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
                    }

                    <form asp-controller="SmsLogin" asp-action="RequestCode" method="post" autocomplete="off">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="form-floating mb-3">
                            <input asp-for="Phone" class="form-control" inputmode="tel"
                                   autocomplete="tel" placeholder="+989121234567" maxlength="16" required />
                            <label asp-for="Phone">@T("Plugins.Sms.MultiSms.Otp.PhoneLabel")</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@T("Plugins.Sms.MultiSms.Otp.SendCode")</button>
                    </form>

                    <hr />

                    <form asp-controller="SmsLogin" asp-action="VerifyCode" method="post" autocomplete="off">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Phone" class="form-control" inputmode="tel"
                                   autocomplete="tel" placeholder="+989121234567" maxlength="16" required />
                            <label asp-for="Phone">@T("Plugins.Sms.MultiSms.Otp.PhoneLabel")</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Code" class="form-control" inputmode="numeric"
                                   autocomplete="one-time-code" placeholder="123456"
                                   pattern="[0-9]{6}" maxlength="6" required />
                            <label asp-for="Code">@T("Plugins.Sms.MultiSms.Otp.CodeLabel")</label>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100">@T("Plugins.Sms.MultiSms.Otp.SignIn")</button>
                    </form>
                    <div class="mt-3 d-flex justify-content-between">
                        <a asp-controller="Identity" asp-action="Login">@T("Plugins.Sms.MultiSms.Otp.PasswordLogin")</a>
                        <a asp-controller="SmsLogin" asp-action="Enroll">@T("Plugins.Sms.MultiSms.Otp.EnrollLink")</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
