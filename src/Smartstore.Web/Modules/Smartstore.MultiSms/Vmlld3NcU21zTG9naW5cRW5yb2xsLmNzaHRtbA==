@model SmsOtpLoginModel

@{
    Layout = "_Layout";
    Assets.AppendTitleParts(T("Plugins.Sms.MultiSms.Otp.EnrollTitle").Value);
    Assets.AddMetaRobots();
}

<div class="page">
    <div class="row justify-content-center my-4">
        <div class="col-12 col-md-8 col-xl-6">
            <h1 class="page-title">@T("Plugins.Sms.MultiSms.Otp.EnrollTitle")</h1>
            <p class="text-muted">@T("Plugins.Sms.MultiSms.Otp.EnrollHint")</p>

            @if (!string.IsNullOrWhiteSpace(Model.VerifiedPhone))
            {
                <div class="alert alert-success">@T("Plugins.Sms.MultiSms.Otp.CurrentVerified", Model.VerifiedPhone)</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-info" role="status">@Model.StatusMessage</div>
            }

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    @if (!Model.CodeRequested)
                    {
                        <form asp-controller="SmsLogin" asp-action="RequestEnrollment" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Phone" class="form-control" inputmode="tel"
                                       autocomplete="tel" placeholder="09123456789" maxlength="16" dir="ltr" autofocus required />
                                <label asp-for="Phone">@T("Plugins.Sms.MultiSms.Otp.PhoneLabel")</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">@T("Plugins.Sms.MultiSms.Otp.SendCode")</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="SmsLogin" asp-action="ConfirmEnrollment" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Phone" class="form-control" inputmode="tel"
                                       autocomplete="tel" placeholder="09123456789" maxlength="16" dir="ltr" readonly />
                                <label asp-for="Phone">@T("Plugins.Sms.MultiSms.Otp.PhoneLabel")</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Code" class="form-control" inputmode="numeric"
                                       autocomplete="one-time-code" placeholder="123456"
                                       pattern="[0-9]{6}" maxlength="6" dir="ltr" autofocus required />
                                <label asp-for="Code">@T("Plugins.Sms.MultiSms.Otp.CodeLabel")</label>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100">@T("Plugins.Sms.MultiSms.Otp.EnableLogin")</button>
                        </form>
                        <form asp-controller="SmsLogin" asp-action="RequestEnrollment" method="post" class="mt-3">
                            <input type="hidden" name="Phone" value="@Model.Phone" />
                            <button type="submit" class="btn btn-link p-0">@T("Plugins.Sms.MultiSms.Otp.SendCode")</button>
                            <a asp-controller="SmsLogin" asp-action="Enroll" class="ml-3">@T("Plugins.Sms.MultiSms.Otp.ChangePhone")</a>
                        </form>
                    }
                </div>
            </div>

            <a class="d-block mt-3" asp-controller="SmsLogin" asp-action="Index">@T("Plugins.Sms.MultiSms.Otp.BackToLogin")</a>
        </div>
    </div>
</div>
